# SERVER CONFIGURATION
SERVER_IP=localhost
PORT=666
HOST=localhost

# LOCAL SERVERS (Wake-on-LAN)
SERVER_INTEL_IP=0.0.0.0
SERVER_INTEL_MAC=00:00:00:00:00:00
SERVER_R3_IP=0.0.0.0
SERVER_R3_MAC=00:00:00:00:00:00

# TELEGRAM BOT CONFIGURATION
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_admin_id

# SSH AUTHENTICATION
SSH_KEY_PATH=~/.ssh/id_rsa.pub
SSH_KEYS=id_ed25519,id_rsa
SSH_PORT=22
SSH_MESSAGE_PREFIX=YaroAdminUI-Auth

# SECURITY
JWT_SECRET=your_jwt_secret_key_change_me_in_production
SESSION_TIMEOUT=3600000
MAX_LOGIN_ATTEMPTS=5
WEBAUTHN_ORIGIN=http://localhost:666

# DATABASE
DB_PATH=./adminui.db
SQLITE_DB=./adminui.db

# API CONFIGURATION
API_KEY=your_secure_api_key_here
ALLOW_CORS=true
CORS_ORIGIN=http://localhost:666

# ENVIRONMENT
NODE_ENV=development

# XRAY VPN MANAGEMENT API
VPN_API_URL=http://127.0.0.1:333
VPN_API_KEY=your_vpn_api_key_here
VPN_SERVER_IP=your_server_ip_here
VPN_BOT_TOKEN=your_telegram_bot_token_here
